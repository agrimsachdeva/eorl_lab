{
 "doctype": "DocType",
 "name": "EORL Episode",
 "module": "EORL Lab",
 "custom": 0,
 "istable": 0,
 "autoname": "format:{run}-EP-{episode_number}",
 "track_changes": 1,
 "field_order": [
  "run",
  "episode_number",
  "phase",
  "status",
  "success",
  "utility",
  "failure_type",
  "section_scenario",
  "scenario_case_id",
  "environmental_state_hash",
  "ground_truth_json",
  "section_timing",
  "started_at",
  "ended_at",
  "cycle_steps",
  "cycle_time_simulated",
  "cycle_time_wallclock",
  "section_outcome",
  "outcome_json",
  "process_signature"
 ],
 "fields": [
  {
   "fieldname": "run",
   "fieldtype": "Link",
   "label": "Run",
   "options": "EORL Run",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "episode_number",
   "fieldtype": "Int",
   "label": "Episode Number",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "phase",
   "fieldtype": "Select",
   "label": "Phase",
   "options": "warmup\nstable\nshock\nrecovery",
   "default": "warmup",
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "pending\nrunning\ncompleted\nfailed",
   "default": "pending",
   "in_list_view": 1
  },
  {
   "fieldname": "success",
   "fieldtype": "Check",
   "label": "Success"
  },
  {
   "fieldname": "utility",
   "fieldtype": "Float",
   "label": "Utility",
   "description": "Outcome utility v1: 0 if the episode did not complete, otherwise 1 minus the share of units rejected on inspection."
  },
  {
   "fieldname": "failure_type",
   "fieldtype": "Data",
   "label": "Failure Type"
  },
  {
   "fieldname": "section_scenario",
   "fieldtype": "Section Break",
   "label": "Scenario"
  },
  {
   "fieldname": "scenario_case_id",
   "fieldtype": "Data",
   "label": "Scenario Case ID"
  },
  {
   "fieldname": "environmental_state_hash",
   "fieldtype": "Data",
   "label": "Environmental State Hash"
  },
  {
   "fieldname": "ground_truth_json",
   "fieldtype": "Code",
   "label": "Ground Truth (JSON)",
   "options": "JSON"
  },
  {
   "fieldname": "section_timing",
   "fieldtype": "Section Break",
   "label": "Timing"
  },
  {
   "fieldname": "started_at",
   "fieldtype": "Datetime",
   "label": "Started At"
  },
  {
   "fieldname": "ended_at",
   "fieldtype": "Datetime",
   "label": "Ended At"
  },
  {
   "fieldname": "cycle_steps",
   "fieldtype": "Int",
   "label": "Cycle Steps"
  },
  {
   "fieldname": "cycle_time_simulated",
   "fieldtype": "Float",
   "label": "Cycle Time (Simulated)"
  },
  {
   "fieldname": "cycle_time_wallclock",
   "fieldtype": "Float",
   "label": "Cycle Time (Wallclock, s)"
  },
  {
   "fieldname": "section_outcome",
   "fieldtype": "Section Break",
   "label": "Outcome"
  },
  {
   "fieldname": "outcome_json",
   "fieldtype": "Code",
   "label": "Outcome (JSON)",
   "options": "JSON"
  },
  {
   "fieldname": "process_signature",
   "fieldtype": "Data",
   "label": "Process Signature"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "EORL Administrator",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "EORL Researcher",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0
  },
  {
   "role": "EORL Viewer",
   "read": 1
  }
 ]
}
