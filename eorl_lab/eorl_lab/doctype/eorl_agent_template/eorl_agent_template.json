{
 "doctype": "DocType",
 "name": "EORL Agent Template",
 "module": "EORL Lab",
 "custom": 0,
 "istable": 0,
 "autoname": "field:template_name",
 "track_changes": 1,
 "field_order": [
  "template_name",
  "organizational_role",
  "enabled",
  "section_role",
  "role_description",
  "responsibilities",
  "local_goal",
  "global_goal_context",
  "information_scope",
  "authority_description",
  "section_bindings",
  "model_profile",
  "memory_profile",
  "tool_policy",
  "section_prompt",
  "initial_system_instructions",
  "decision_schema_version",
  "section_interaction",
  "communication_enabled",
  "max_messages_per_episode",
  "max_decisions_per_episode",
  "section_theory",
  "local_goal_weight",
  "global_goal_weight",
  "compliance_weight",
  "search_budget",
  "communication_budget"
 ],
 "fields": [
  {"fieldname": "template_name", "fieldtype": "Data", "label": "Template Name", "reqd": 1, "unique": 1},
  {"fieldname": "organizational_role", "fieldtype": "Data", "label": "Organizational Role", "reqd": 1},
  {"fieldname": "enabled", "fieldtype": "Check", "label": "Enabled", "default": "1"},
  {"fieldname": "section_role", "fieldtype": "Section Break", "label": "Role"},
  {"fieldname": "role_description", "fieldtype": "Text", "label": "Role Description"},
  {"fieldname": "responsibilities", "fieldtype": "Text", "label": "Responsibilities"},
  {"fieldname": "local_goal", "fieldtype": "Text", "label": "Local Goal"},
  {"fieldname": "global_goal_context", "fieldtype": "Text", "label": "Global Goal Context"},
  {"fieldname": "information_scope", "fieldtype": "Text", "label": "Information Scope"},
  {"fieldname": "authority_description", "fieldtype": "Text", "label": "Authority Description", "description": "Descriptive only. Actual authority is enforced by the EORL Tool Policy / authority firewall, not by this text."},
  {"fieldname": "section_bindings", "fieldtype": "Section Break", "label": "Bindings"},
  {"fieldname": "model_profile", "fieldtype": "Link", "label": "Model Profile", "options": "EORL Model Profile", "reqd": 1},
  {"fieldname": "memory_profile", "fieldtype": "Link", "label": "Memory Profile", "options": "EORL Memory Profile"},
  {"fieldname": "tool_policy", "fieldtype": "Link", "label": "Tool Policy", "options": "EORL Tool Policy", "reqd": 1},
  {"fieldname": "section_prompt", "fieldtype": "Section Break", "label": "Prompt"},
  {"fieldname": "initial_system_instructions", "fieldtype": "Code", "label": "Initial System Instructions"},
  {"fieldname": "decision_schema_version", "fieldtype": "Data", "label": "Decision Schema Version", "default": "1.0"},
  {"fieldname": "section_interaction", "fieldtype": "Section Break", "label": "Interaction Limits"},
  {"fieldname": "communication_enabled", "fieldtype": "Check", "label": "Communication Enabled"},
  {"fieldname": "max_messages_per_episode", "fieldtype": "Int", "label": "Max Messages Per Episode"},
  {"fieldname": "max_decisions_per_episode", "fieldtype": "Int", "label": "Max Decisions Per Episode"},
  {"fieldname": "section_theory", "fieldtype": "Section Break", "label": "Theory Variables (optional)", "collapsible": 1},
  {"fieldname": "local_goal_weight", "fieldtype": "Float", "label": "Local Goal Weight"},
  {"fieldname": "global_goal_weight", "fieldtype": "Float", "label": "Global Goal Weight"},
  {"fieldname": "compliance_weight", "fieldtype": "Float", "label": "Compliance Weight"},
  {"fieldname": "search_budget", "fieldtype": "Int", "label": "Search Budget"},
  {"fieldname": "communication_budget", "fieldtype": "Int", "label": "Communication Budget"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "EORL Administrator", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "EORL Researcher", "read": 1, "write": 1, "create": 1, "delete": 0},
  {"role": "EORL Viewer", "read": 1}
 ]
}
