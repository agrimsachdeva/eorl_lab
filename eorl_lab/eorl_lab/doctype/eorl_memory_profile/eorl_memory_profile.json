{
 "doctype": "DocType",
 "name": "EORL Memory Profile",
 "module": "EORL Lab",
 "custom": 0,
 "istable": 0,
 "autoname": "field:profile_name",
 "track_changes": 1,
 "field_order": [
  "profile_name",
  "section_local",
  "local_memory_enabled",
  "local_backend",
  "local_retention_episodes",
  "local_top_k",
  "recency_weight",
  "similarity_weight",
  "outcome_weight",
  "summarization_enabled",
  "summary_interval",
  "forgetting_enabled",
  "forgetting_half_life",
  "section_shared",
  "shared_memory_enabled",
  "shared_backend",
  "shared_visibility_scope",
  "shared_write_policy",
  "shared_top_k",
  "embedding_model_profile"
 ],
 "fields": [
  {"fieldname": "profile_name", "fieldtype": "Data", "label": "Profile Name", "reqd": 1, "unique": 1},
  {"fieldname": "section_local", "fieldtype": "Section Break", "label": "Local Memory"},
  {"fieldname": "local_memory_enabled", "fieldtype": "Check", "label": "Local Memory Enabled", "default": "1"},
  {"fieldname": "local_backend", "fieldtype": "Select", "label": "Local Backend", "options": "recent\nepisodic\nvector\nnone"},
  {"fieldname": "local_retention_episodes", "fieldtype": "Int", "label": "Local Retention Episodes"},
  {"fieldname": "local_top_k", "fieldtype": "Int", "label": "Local Top K"},
  {"fieldname": "recency_weight", "fieldtype": "Float", "label": "Recency Weight"},
  {"fieldname": "similarity_weight", "fieldtype": "Float", "label": "Similarity Weight"},
  {"fieldname": "outcome_weight", "fieldtype": "Float", "label": "Outcome Weight"},
  {"fieldname": "summarization_enabled", "fieldtype": "Check", "label": "Summarization Enabled"},
  {"fieldname": "summary_interval", "fieldtype": "Int", "label": "Summary Interval"},
  {"fieldname": "forgetting_enabled", "fieldtype": "Check", "label": "Forgetting Enabled"},
  {"fieldname": "forgetting_half_life", "fieldtype": "Float", "label": "Forgetting Half-Life"},
  {"fieldname": "section_shared", "fieldtype": "Section Break", "label": "Shared Memory"},
  {"fieldname": "shared_memory_enabled", "fieldtype": "Check", "label": "Shared Memory Enabled"},
  {"fieldname": "shared_backend", "fieldtype": "Data", "label": "Shared Backend"},
  {"fieldname": "shared_visibility_scope", "fieldtype": "Data", "label": "Shared Visibility Scope"},
  {"fieldname": "shared_write_policy", "fieldtype": "Select", "label": "Shared Write Policy", "options": "all\nsuccesses_only\ncurated\nnone"},
  {"fieldname": "shared_top_k", "fieldtype": "Int", "label": "Shared Top K"},
  {"fieldname": "embedding_model_profile", "fieldtype": "Link", "label": "Embedding Model Profile", "options": "EORL Model Profile"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "EORL Administrator", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "EORL Researcher", "read": 1, "write": 1, "create": 1, "delete": 0},
  {"role": "EORL Viewer", "read": 1}
 ]
}
