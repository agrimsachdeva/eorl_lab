{
 "doctype": "DocType",
 "name": "EORL Run",
 "module": "EORL Lab",
 "custom": 0,
 "istable": 0,
 "autoname": "RUN-.#####",
 "track_changes": 1,
 "field_order": [
  "status",
  "run_seed",
  "current_episode",
  "section_lineage",
  "parent_run",
  "branch_point_episode",
  "section_timing",
  "started_at",
  "ended_at",
  "section_snapshots",
  "architecture_snapshot_json",
  "agent_snapshots_json",
  "scenario_snapshot_json",
  "regime_shift_snapshot_json",
  "provider_snapshots_json",
  "section_provenance",
  "code_commit",
  "app_version",
  "erpnext_version",
  "frappe_version",
  "site_fingerprint",
  "run_manifest_hash",
  "section_outcome",
  "failure_reason",
  "event_count",
  "total_tokens",
  "total_cost"
 ],
 "fields": [
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "queued\ninitializing\nrunning\ncompleted\nfailed\naborted", "default": "queued", "in_list_view": 1},
  {"fieldname": "run_seed", "fieldtype": "Int", "label": "Run Seed", "in_list_view": 1},
  {"fieldname": "current_episode", "fieldtype": "Int", "label": "Current Episode"},
  {"fieldname": "section_lineage", "fieldtype": "Section Break", "label": "Lineage", "collapsible": 1, "description": "SOTA Milestone 2 (V2 section 17 / 27's 'parent branch/run if any'). Blank for a run that wasn't created by branching."},
  {"fieldname": "parent_run", "fieldtype": "Link", "label": "Parent Run", "options": "EORL Run", "in_list_view": 1, "search_index": 1},
  {"fieldname": "branch_point_episode", "fieldtype": "Int", "label": "Branch Point Episode", "description": "The parent run's episode number this run diverged from. Episodes 1..branch_point_episode are owned by the parent, never duplicated -- see eorl_lab.runtime.orchestrator.get_full_branch_history."},
  {"fieldname": "section_timing", "fieldtype": "Section Break", "label": "Timing"},
  {"fieldname": "started_at", "fieldtype": "Datetime", "label": "Started At"},
  {"fieldname": "ended_at", "fieldtype": "Datetime", "label": "Ended At"},
  {"fieldname": "section_snapshots", "fieldtype": "Section Break", "label": "Experimental Snapshots", "collapsible": 1, "description": "Experiment/architecture-level snapshotting arrives with the Experiment Studio milestone; populated here opportunistically until then."},
  {"fieldname": "architecture_snapshot_json", "fieldtype": "Code", "label": "Architecture Snapshot (JSON)", "options": "JSON"},
  {"fieldname": "agent_snapshots_json", "fieldtype": "Code", "label": "Agent Snapshots (JSON)", "options": "JSON"},
  {"fieldname": "scenario_snapshot_json", "fieldtype": "Code", "label": "Scenario Snapshot (JSON)", "options": "JSON"},
  {"fieldname": "regime_shift_snapshot_json", "fieldtype": "Code", "label": "Regime Shift Snapshot (JSON)", "options": "JSON"},
  {"fieldname": "provider_snapshots_json", "fieldtype": "Code", "label": "Provider Snapshots (JSON)", "options": "JSON"},
  {"fieldname": "section_provenance", "fieldtype": "Section Break", "label": "Provenance", "collapsible": 1},
  {"fieldname": "code_commit", "fieldtype": "Data", "label": "Code Commit"},
  {"fieldname": "app_version", "fieldtype": "Data", "label": "App Version"},
  {"fieldname": "erpnext_version", "fieldtype": "Data", "label": "ERPNext Version"},
  {"fieldname": "frappe_version", "fieldtype": "Data", "label": "Frappe Version"},
  {"fieldname": "site_fingerprint", "fieldtype": "Data", "label": "Site Fingerprint"},
  {"fieldname": "run_manifest_hash", "fieldtype": "Data", "label": "Run Manifest Hash"},
  {"fieldname": "section_outcome", "fieldtype": "Section Break", "label": "Outcome"},
  {"fieldname": "failure_reason", "fieldtype": "Small Text", "label": "Failure Reason"},
  {"fieldname": "event_count", "fieldtype": "Int", "label": "Event Count"},
  {"fieldname": "total_tokens", "fieldtype": "Int", "label": "Total Tokens"},
  {"fieldname": "total_cost", "fieldtype": "Float", "label": "Total Cost"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "EORL Administrator", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "EORL Researcher", "read": 1, "write": 1, "create": 1, "delete": 0},
  {"role": "EORL Viewer", "read": 1}
 ]
}
