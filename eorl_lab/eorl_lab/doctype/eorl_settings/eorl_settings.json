   "fieldtype": "Check",
   "label": "Enable ERP Diff Capture",
   "default": "1"
  },
  {
   "fieldname": "enable_memory_snapshotting",
   "fieldtype": "Check",
   "label": "Enable Memory Snapshotting",
   "default": "1"
  },
  {
   "fieldname": "section_security",
   "fieldtype": "Section Break",
   "label": "Security"
  },
  {
   "fieldname": "allow_proprietary_models",
